#!/usr/bin/env bash
# Runs an MCP server (or any command) with the Bitwarden Secrets Manager project injected as
# env vars, so only that process sees secret values. Synced from claude-dotfiles/repo-kit.
set -euo pipefail

fail() { echo "with-secrets: $*" >&2; exit 1; }
[[ $# -gt 0 ]] || fail "usage: with-secrets <command> [args...]"

kit="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
conf="$kit/bitwarden.conf"
# shellcheck source=/dev/null
[[ -f "$conf" ]] && . "$conf"
[[ -n "${BWS_PROJECT_ID:-}" ]] || fail "BWS_PROJECT_ID not set (expected in $conf)"

export PATH="$HOME/.local/bin:$HOME/.bws/bin:$PATH"
if ! command -v bws >/dev/null 2>&1 && [[ "${CLAUDE_CODE_REMOTE:-}" == "true" ]]; then
  # The checksum-verified installer from the cloud hook; sourcing it only defines functions.
  [[ -f "$kit/hooks/cloud-setup.sh" ]] || fail "bws not found and $kit/hooks/cloud-setup.sh is missing"
  # shellcheck disable=SC1091 source-path=SCRIPTDIR/.. source=hooks/cloud-setup.sh
  . "$kit/hooks/cloud-setup.sh"
  install_bws </dev/null >&2 || fail "bws not found and installing it failed"
fi
command -v bws >/dev/null 2>&1 || fail "bws not found; run claude-dotfiles/install.sh"

token="${BWS_ACCESS_TOKEN:-}"
if [[ -z "$token" ]] && command -v security >/dev/null 2>&1; then
  token="$(security find-generic-password -s bws-access-token -a "${USER:-$(id -un)}" -w 2>/dev/null || true)"
fi
if [[ -z "$token" && -r "$HOME/.config/bws/token" ]]; then
  token="$(cat "$HOME/.config/bws/token")"
fi
[[ -n "$token" ]] || fail "no Bitwarden access token (env BWS_ACCESS_TOKEN, Keychain item 'bws-access-token', or ~/.config/bws/token)"
export BWS_ACCESS_TOKEN="$token"

server_args=()
[[ -n "${BWS_SERVER_URL:-}" ]] && server_args=(--server-url "$BWS_SERVER_URL")

# bash 3.2's `printf %q` leaves a leading `~` unescaped (it relies on the *reader* treating a
# quoted string as non-expanding, which is true again here, but %q's own output for e.g. `~/x`
# is the bare text `~/x` with no surrounding quotes at all) so a tilde in an argument gets
# expanded when the quoted command string is re-parsed by `bws run`'s shell. Quote every
# argument POSIX-style instead: wrap in single quotes, escaping embedded single quotes as '\''.
quote_arg() {
  local s=$1 q="'" bq="'\''"
  printf "'%s'" "${s//$q/$bq}"
}

cmd=""
for a in "$@"; do
  cmd="$cmd $(quote_arg "$a")"
done
cmd="${cmd# }"

exec bws run --shell bash ${server_args[@]+"${server_args[@]}"} --project-id "$BWS_PROJECT_ID" -- "unset BWS_ACCESS_TOKEN; exec $cmd"
