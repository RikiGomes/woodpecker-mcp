# woodpecker-mcp instance configuration.
# Copy to .env.woodpecker in the directory the MCP server is launched from
# (usually your project root), or export the variables in your shell.
# Tokens: <server>/user/cli-and-api on each Woodpecker instance.

# Single instance (named "default"):
#WOODPECKER_URL=https://ci.example.com
#WOODPECKER_TOKEN=

# One pair per instance — <NAME> (lowercased) becomes the `instance` tool argument:
#WOODPECKER_MYPROJECT_URL=https://ci.myproject.example
#WOODPECKER_MYPROJECT_TOKEN=
