{
  "name": "woodpecker-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Woodpecker CI — read-only pipeline status and logs across multiple self-hosted instances",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "woodpecker",
    "woodpecker-ci",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RikiGomes/woodpecker-mcp.git"
  },
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "woodpecker-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "node src/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
